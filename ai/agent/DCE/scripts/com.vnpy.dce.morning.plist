<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
    "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.vnpy.dce.morning</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/zsh</string>
        <string>/Users/lishengkun/MyDocuments/Duke/stock/vnpy/ai/agent/DCE/scripts/run_morning.sh</string>
    </array>

    <!-- 每天 08:30 触发 -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>8</integer>
        <key>Minute</key>
        <integer>30</integer>
    </dict>

    <!-- 运行日志由 run_morning.sh 写入 logs/auto/morning_YYYYMMDD_HHMMSS.log，此处不再重复 -->

    <key>ThrottleInterval</key>
    <integer>60</integer>

    <!-- 任务运行超过 7200 秒（2小时）后强制 kill，防止卡死阻塞下次触发 -->
    <key>TimeoutStopInterval</key>
    <integer>7200</integer>

    <key>NetworkState</key>
    <true/>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/Users/lishengkun/.local/bin:/usr/local/bin:/usr/bin:/bin</string>
        <key>HOME</key>
        <string>/Users/lishengkun</string>
    </dict>
</dict>
</plist>
